-- =============================================================================
-- SECTION 6: COMPLEX ANALYTICAL QUERIES
-- =============================================================================

-- 6.1 Customer Segmentation using Window Functions
WITH customer_metrics AS (
    SELECT 
        u.user_id,
        CONCAT(u.first_name, ' ', u.last_name) as customer_name,
        COUNT(DISTINCT o.order_id) as order_count,
        COALESCE(SUM(o.total_amount), 0) as total_spent,
        COALESCE(AVG(o.total_amount), 0) as avg_order_value,
        MAX(o.order_date) as last_order_date,
        DATEDIFF(NOW(), COALESCE(MAX(o.order_date), NOW())) as days_since_last_order
    FROM users u
    LEFT JOIN orders o ON u.user_id = o.user_id AND o.order_status = 'delivered'
    GROUP BY u.user_id, u.first_name, u.last_name
),
customer_segments AS (
    SELECT 
        *,
        NTILE(4) OVER (ORDER BY total_spent DESC) as spending_quartile,
        CASE 
            WHEN days_since_last_order <= 30 THEN 'Active'
            WHEN days_since_last_order <= 60 THEN 'Recent'
            WHEN days_since_last_order <= 90 THEN 'Lapsed'
            ELSE 'Inactive'
        END as activity_status,
        CASE 
            WHEN order_count >= 5 THEN 'VIP'
            WHEN order_count >= 2 THEN 'Regular'
            ELSE 'Occasional'
        END as customer_type,
        SUM(total_spent) OVER() as total_revenue,
        ROUND(100.0 * total_spent / NULLIF(SUM(total_spent) OVER(), 0), 2) as pct_of_total
    FROM customer_metrics
)
SELECT * FROM customer_segments
ORDER BY total_spent DESC;

-- 6.2 Cohort Analysis - Customer Retention
WITH cohorts AS (
    SELECT 
        u.user_id,
        DATE_FORMAT(u.created_at, '%Y-%m') as cohort_month,
        DATE_FORMAT(o.order_date, '%Y-%m') as order_month,
        TIMESTAMPDIFF(MONTH, u.created_at, o.order_date) as months_since_first
    FROM users u
    LEFT JOIN orders o ON u.user_id = o.user_id AND o.order_status = 'delivered'
),
cohort_size AS (
    SELECT 
        cohort_month,
        COUNT(DISTINCT user_id) as total_users
    FROM cohorts
    GROUP BY cohort_month
),
retention_table AS (
    SELECT 
        c.cohort_month,
        cs.total_users,
        c.months_since_first,
        COUNT(DISTINCT c.user_id) as retained_users,
        ROUND(100.0 * COUNT(DISTINCT c.user_id) / NULLIF(cs.total_users, 0), 2) as retention_rate
    FROM cohorts c
    JOIN cohort_size cs ON c.cohort_month = cs.cohort_month
    WHERE c.months_since_first IS NOT NULL
    GROUP BY c.cohort_month, cs.total_users, c.months_since_first
)
SELECT 
    cohort_month,
    MAX(CASE WHEN months_since_first = 0 THEN retention_rate END) as 'Month 0',
    MAX(CASE WHEN months_since_first = 1 THEN retention_rate END) as 'Month 1',
    MAX(CASE WHEN months_since_first = 2 THEN retention_rate END) as 'Month 2',
    MAX(CASE WHEN months_since_first = 3 THEN retention_rate END) as 'Month 3'
FROM retention_table
GROUP BY cohort_month
ORDER BY cohort_month;

-- 6.3 Product Affinity Analysis (Market Basket)
SELECT 
    a.product_name as product_1,
    b.product_name as product_2,
    COUNT(*) as times_bought_together,
    ROUND(100.0 * COUNT(*) / NULLIF((
        SELECT COUNT(DISTINCT order_id) FROM order_items WHERE product_id = a.product_id
    ), 0), 2) as confidence
FROM order_items oi1
JOIN order_items oi2 ON oi1.order_id = oi2.order_id AND oi1.product_id < oi2.product_id
JOIN products a ON oi1.product_id = a.product_id
JOIN products b ON oi2.product_id = b.product_id
GROUP BY a.product_name, b.product_name
HAVING times_bought_together > 1
ORDER BY times_bought_together DESC
LIMIT 10;

-- 6.4 Moving Averages and Trends
WITH daily_sales AS (
    SELECT 
        DATE(o.order_date) as sale_date,
        SUM(o.total_amount) as daily_revenue,
        COUNT(DISTINCT o.order_id) as daily_orders
    FROM orders o
    WHERE o.order_status = 'delivered'
    GROUP BY DATE(o.order_date)
)
SELECT 
    sale_date,
    daily_revenue,
    daily_orders,
    AVG(daily_revenue) OVER (ORDER BY sale_date ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) as revenue_7day_avg,
    AVG(daily_revenue) OVER (ORDER BY sale_date ROWS BETWEEN 29 PRECEDING AND CURRENT ROW) as revenue_30day_avg,
    ROUND(100.0 * (daily_revenue - LAG(daily_revenue, 7) OVER (ORDER BY sale_date)) / 
          NULLIF(LAG(daily_revenue, 7) OVER (ORDER BY sale_date), 0), 2) as pct_change_week_over_week
FROM daily_sales
ORDER BY sale_date;

-- 6.5 Inventory Turnover Analysis
WITH product_sales AS (
    SELECT 
        p.product_id,
        p.product_name,
        c.category_name,
        i.quantity_on_hand,
        COALESCE(SUM(
            CASE 
                WHEN o.order_status = 'delivered'
                AND o.order_date >= DATE_SUB(NOW(), INTERVAL 30 DAY)
                THEN oi.quantity
                ELSE 0
            END
        ), 0) as units_sold_last_30_days,
        COUNT(DISTINCT 
            CASE 
                WHEN o.order_status = 'delivered'
                AND o.order_date >= DATE_SUB(NOW(), INTERVAL 30 DAY)
                THEN o.order_id
                ELSE NULL
            END
        ) as orders_in_last_30_days
    FROM products p
    JOIN categories c ON p.category_id = c.category_id
    JOIN inventory i ON p.product_id = i.product_id
    LEFT JOIN order_items oi ON p.product_id = oi.product_id
    LEFT JOIN orders o ON oi.order_id = o.order_id
    GROUP BY p.product_id, p.product_name, c.category_name, i.quantity_on_hand
)
SELECT 
    *,
    CASE 
        WHEN units_sold_last_30_days > 0 
        THEN ROUND(quantity_on_hand / (units_sold_last_30_days / 30.0), 1)
        ELSE NULL 
    END as days_of_inventory,
    CASE 
        WHEN units_sold_last_30_days > 20 THEN 'High Demand'
        WHEN units_sold_last_30_days > 5 THEN 'Medium Demand'
        WHEN units_sold_last_30_days > 0 THEN 'Low Demand'
        ELSE 'No Sales'
    END as demand_category
FROM product_sales
ORDER BY days_of_inventory;

-- 6.6 Recency-Frequency-Monetary (RFM) Analysis
WITH rfm_calc AS (
    SELECT 
        u.user_id,
        CONCAT(u.first_name, ' ', u.last_name) as customer_name,
        DATEDIFF(NOW(), COALESCE(MAX(o.order_date), NOW())) as recency,
        COALESCE(COUNT(DISTINCT o.order_id), 0) as frequency,
        COALESCE(SUM(o.total_amount), 0) as monetary,
        NTILE(5) OVER (ORDER BY DATEDIFF(NOW(), COALESCE(MAX(o.order_date), NOW())) DESC) as r_score,
        NTILE(5) OVER (ORDER BY COALESCE(COUNT(DISTINCT o.order_id), 0) ASC) as f_score,
        NTILE(5) OVER (ORDER BY COALESCE(SUM(o.total_amount), 0) ASC) as m_score
    FROM users u
    LEFT JOIN orders o ON u.user_id = o.user_id AND o.order_status = 'delivered'
    GROUP BY u.user_id, u.first_name, u.last_name
),
rfm_scores AS (
    SELECT 
        *,
        CONCAT(r_score, f_score, m_score) as rfm_cell,
        (r_score + f_score + m_score) / 3.0 as avg_score
    FROM rfm_calc
)
SELECT 
    *,
    CASE 
        WHEN r_score >= 4 AND f_score >= 4 AND m_score >= 4 THEN 'Champions'
        WHEN r_score >= 3 AND f_score >= 3 AND m_score >= 3 THEN 'Loyal Customers'
        WHEN r_score >= 3 AND f_score >= 2 AND m_score >= 2 THEN 'Potential Loyalists'
        WHEN r_score >= 4 AND f_score <= 2 AND m_score <= 2 THEN 'New Customers'
        WHEN r_score <= 2 AND f_score >= 4 AND m_score >= 4 THEN 'At Risk'
        WHEN r_score <= 2 AND f_score <= 2 AND m_score <= 2 THEN 'Lost'
        ELSE 'Others'
    END as customer_segment
FROM rfm_scores
ORDER BY avg_score DESC;

-- 6.7 Month-over-Month Growth Analysis
WITH monthly_metrics AS (
    SELECT 
        DATE_FORMAT(order_date, '%Y-%m') as month,
        COUNT(DISTINCT order_id) as orders,
        COUNT(DISTINCT user_id) as customers,
        SUM(total_amount) as revenue,
        COALESCE(SUM(total_amount) / NULLIF(COUNT(DISTINCT order_id), 0), 0) as aov
    FROM orders
    WHERE order_status = 'delivered'
    GROUP BY DATE_FORMAT(order_date, '%Y-%m')
),
growth_metrics AS (
    SELECT 
        month,
        orders,
        customers,
        ROUND(revenue, 2) as revenue,
        ROUND(aov, 2) as aov,
        ROUND(100.0 * (orders - LAG(orders) OVER (ORDER BY month)) / 
              NULLIF(LAG(orders) OVER (ORDER BY month), 0), 2) as orders_growth_pct,
        ROUND(100.0 * (revenue - LAG(revenue) OVER (ORDER BY month)) / 
              NULLIF(LAG(revenue) OVER (ORDER BY month), 0), 2) as revenue_growth_pct
    FROM monthly_metrics
)
SELECT * FROM growth_metrics;

-- =============================================================================
-- SECTION 7: BUSINESS REPORTS
-- =============================================================================

-- 7.1 Executive Dashboard
SELECT 
    'TOTAL REVENUE' as metric,
    CONCAT('$', FORMAT(SUM(total_amount), 2)) as value
FROM orders 
WHERE order_status = 'delivered'
UNION ALL
SELECT 
    'TOTAL ORDERS',
    FORMAT(COUNT(*), 0)
FROM orders 
WHERE order_status = 'delivered'
UNION ALL
SELECT 
    'AVG ORDER VALUE',
    CONCAT('$', FORMAT(AVG(total_amount), 2))
FROM orders 
WHERE order_status = 'delivered'
UNION ALL
SELECT 
    'TOTAL CUSTOMERS',
    FORMAT(COUNT(DISTINCT user_id), 0)
FROM orders 
WHERE order_status = 'delivered'
UNION ALL
SELECT 
    'REPEAT CUSTOMER RATE',
    CONCAT(
        ROUND(100.0 * (
            SELECT COUNT(DISTINCT user_id) 
            FROM (
                SELECT user_id, COUNT(*) as order_count
                FROM orders 
                WHERE order_status = 'delivered'
                GROUP BY user_id
                HAVING COUNT(*) > 1
            ) as repeat_customers
        ) / NULLIF(COUNT(DISTINCT user_id), 0), 2),
        '%'
    )
FROM orders 
WHERE order_status = 'delivered';

-- 7.2 Top Products by Revenue
SELECT 
    p.product_name,
    c.category_name,
    COUNT(DISTINCT oi.order_id) as times_ordered,
    SUM(oi.quantity) as total_units_sold,
    CONCAT('$', FORMAT(SUM(oi.total_price), 2)) as total_revenue,
    ROUND(AVG(pr.rating), 2) as avg_rating
FROM products p
JOIN categories c ON p.category_id = c.category_id
LEFT JOIN order_items oi ON p.product_id = oi.product_id
LEFT JOIN orders o ON oi.order_id = o.order_id AND o.order_status = 'delivered'
LEFT JOIN product_reviews pr ON p.product_id = pr.product_id
GROUP BY p.product_id, p.product_name, c.category_name
ORDER BY SUM(oi.total_price) DESC
LIMIT 10;

-- 7.3 Customer Lifetime Value Report
SELECT 
    CONCAT(u.first_name, ' ', u.last_name) as customer_name,
    u.email,
    COUNT(DISTINCT o.order_id) as total_orders,
    CONCAT('$', FORMAT(COALESCE(SUM(o.total_amount), 0), 2)) as lifetime_value,
    CONCAT('$', FORMAT(COALESCE(AVG(o.total_amount), 0), 2)) as avg_order_value,
    MIN(o.order_date) as first_purchase,
    MAX(o.order_date) as last_purchase,
    DATEDIFF(COALESCE(MAX(o.order_date), NOW()), COALESCE(MIN(o.order_date), NOW())) as customer_lifetime_days
FROM users u
LEFT JOIN orders o ON u.user_id = o.user_id AND o.order_status = 'delivered'
GROUP BY u.user_id, u.first_name, u.last_name, u.email
HAVING total_orders > 0
ORDER BY SUM(o.total_amount) DESC;

-- 7.4 Inventory Status Report
SELECT 
    p.product_name,
    p.sku,
    i.quantity_on_hand as current_stock,
    i.quantity_reserved as reserved,
    (i.quantity_on_hand - i.quantity_reserved) as available,
    COALESCE(SUM(
        CASE 
            WHEN o.order_status = 'delivered'
            AND o.order_date >= DATE_SUB(NOW(), INTERVAL 30 DAY)
            THEN oi.quantity
            ELSE 0
        END
    ), 0) as sold_last_30_days,
    i.reorder_level,
    i.reorder_quantity,
    CASE 
        WHEN (i.quantity_on_hand - i.quantity_reserved) <= i.reorder_level THEN 'ORDER NOW'
        WHEN (i.quantity_on_hand - i.quantity_reserved) <= i.reorder_level * 2 THEN 'Order Soon'
        ELSE 'OK'
    END as action_required
FROM products p
JOIN inventory i ON p.product_id = i.product_id
LEFT JOIN order_items oi ON p.product_id = oi.product_id
LEFT JOIN orders o ON oi.order_id = o.order_id
GROUP BY p.product_id, p.product_name, p.sku, i.quantity_on_hand, 
         i.quantity_reserved, i.reorder_level, i.reorder_quantity
ORDER BY action_required, available;

-- 7.5 Category Performance Summary
SELECT 
    c.category_name,
    COUNT(DISTINCT p.product_id) as products_in_category,
    COUNT(DISTINCT oi.order_id) as total_orders,
    COALESCE(SUM(oi.quantity), 0) as units_sold,
    CONCAT('$', FORMAT(COALESCE(SUM(oi.total_price), 0), 2)) as revenue,
    ROUND(COALESCE(AVG(pr.rating), 0), 2) as avg_category_rating
FROM categories c
LEFT JOIN products p ON c.category_id = p.category_id
LEFT JOIN order_items oi ON p.product_id = oi.product_id
LEFT JOIN orders o ON oi.order_id = o.order_id AND o.order_status = 'delivered'
LEFT JOIN product_reviews pr ON p.product_id = pr.product_id
GROUP BY c.category_id, c.category_name
ORDER BY SUM(oi.total_price) DESC;

-- =============================================================================
-- SECTION 8: PERFORMANCE OPTIMIZATION
-- =============================================================================

-- 8.1 Create Indexes for Query Performance
CREATE INDEX idx_orders_date_status ON orders(order_date, order_status);
CREATE INDEX idx_order_items_order_product ON order_items(order_id, product_id);
CREATE INDEX idx_reviews_product_rating ON product_reviews(product_id, rating);
CREATE INDEX idx_inventory_status ON inventory(quantity_on_hand, reorder_level);
CREATE INDEX idx_orders_user_date ON orders(user_id, order_date);
CREATE INDEX idx_orders_status_date_user ON orders(order_status, order_date, user_id);

-- 8.2 Daily Sales Materialized View
CREATE VIEW mv_daily_sales AS
SELECT 
    DATE(o.order_date) as sale_date,
    COUNT(DISTINCT o.order_id) as order_count,
    COUNT(DISTINCT o.user_id) as customer_count,
    SUM(o.total_amount) as revenue,
    SUM(oi.quantity) as items_sold
FROM orders o
JOIN order_items oi ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
GROUP BY DATE(o.order_date);

-- 8.3 Query Performance Analysis
EXPLAIN
SELECT 
    c.category_name,
    COUNT(DISTINCT o.user_id) as unique_customers,
    SUM(oi.quantity) as total_units,
    AVG(oi.unit_price) as avg_price
FROM categories c
JOIN products p ON c.category_id = p.category_id
JOIN order_items oi ON p.product_id = oi.product_id
JOIN orders o ON oi.order_id = o.order_id
WHERE o.order_date >= DATE_SUB(NOW(), INTERVAL 90 DAY)
GROUP BY c.category_name;

-- =============================================================================
-- SECTION 9: STORED PROCEDURES FOR REGULAR REPORTS
-- =============================================================================

DELIMITER $$

-- 9.1 Daily Sales Report
CREATE PROCEDURE sp_daily_sales_report(IN report_date DATE)
BEGIN
    SELECT 
        DATE(o.order_date) as sale_date,
        HOUR(o.order_date) as hour_of_day,
        COUNT(DISTINCT o.order_id) as orders,
        COUNT(DISTINCT o.user_id) as customers,
        COUNT(DISTINCT oi.product_id) as unique_products,
        SUM(oi.quantity) as items_sold,
        SUM(o.total_amount) as revenue,
        AVG(o.total_amount) as avg_order_value
    FROM orders o
    JOIN order_items oi ON o.order_id = oi.order_id
    WHERE DATE(o.order_date) = report_date
        AND o.order_status = 'delivered'
    GROUP BY DATE(o.order_date), HOUR(o.order_date)
    ORDER BY hour_of_day;
END$$

-- 9.2 Customer Purchase History
CREATE PROCEDURE sp_customer_purchase_history(IN p_user_id INT)
BEGIN
    SELECT 
        o.order_id,
        o.order_date,
        o.order_status,
        o.total_amount,
        GROUP_CONCAT(
            CONCAT(oi.quantity, 'x ', p.product_name) 
            SEPARATOR ', '
        ) as items_purchased,
        TIMESTAMPDIFF(DAY, o.order_date, NOW()) as days_ago
    FROM orders o
    JOIN order_items oi ON o.order_id = oi.order_id
    JOIN products p ON oi.product_id = p.product_id
    WHERE o.user_id = p_user_id
    GROUP BY o.order_id, o.order_date, o.order_status, o.total_amount
    ORDER BY o.order_date DESC;
END$$

-- 9.3 Low Stock Alert
CREATE PROCEDURE sp_low_stock_alert(IN threshold INT)
BEGIN
    SELECT 
        p.product_id,
        p.product_name,
        p.sku,
        i.quantity_on_hand,
        i.reorder_level,
        i.quantity_on_hand - i.quantity_reserved as available,
        COALESCE(s.supplier_name, 'No Supplier') as preferred_supplier,
        ps.supply_price,
        ps.lead_time_days
    FROM products p
    JOIN inventory i ON p.product_id = i.product_id
    LEFT JOIN product_suppliers ps ON p.product_id = ps.product_id AND ps.is_preferred = TRUE
    LEFT JOIN suppliers s ON ps.supplier_id = s.supplier_id
    WHERE (i.quantity_on_hand - i.quantity_reserved) <= threshold
    ORDER BY (i.quantity_on_hand - i.quantity_reserved) ASC;
END$$

DELIMITER ;

-- =============================================================================
-- SECTION 10: DATA QUALITY CHECKS
-- =============================================================================

-- 10.1 Orphan Records Check
SELECT 'Orders without users' as check_name, COUNT(*) as count
FROM orders o
LEFT JOIN users u ON o.user_id = u.user_id
WHERE u.user_id IS NULL
UNION ALL
SELECT 'Order items without orders', COUNT(*)
FROM order_items oi
LEFT JOIN orders o ON oi.order_id = o.order_id
WHERE o.order_id IS NULL
UNION ALL
SELECT 'Products without categories', COUNT(*)
FROM products p
LEFT JOIN categories c ON p.category_id = c.category_id
WHERE c.category_id IS NULL;

-- 10.2 Data Consistency Checks
SELECT 
    SUM(CASE WHEN ABS(o.total_amount - 
        (oi.order_subtotal + o.tax_amount + o.shipping_amount - o.discount_amount)) > 0.01
        THEN 1 ELSE 0 END) as inconsistent_totals
FROM orders o
JOIN (
    SELECT order_id, SUM(total_price) as order_subtotal
    FROM order_items
    GROUP BY order_id
) oi ON o.order_id = oi.order_id;

-- 10.3 Duplicate Check
SELECT 
    email, 
    COUNT(*) as duplicate_count
FROM users
GROUP BY email
HAVING COUNT(*) > 1;

